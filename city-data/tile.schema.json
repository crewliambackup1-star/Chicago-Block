{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crewliambackup1-star.github.io/Chicago-Block/city-data/tile.schema.json",
  "title": "Chicago Block normalized city tile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "tileId",
    "tileX",
    "tileZ",
    "tileSizeMeters",
    "bounds",
    "source",
    "streets",
    "buildings"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "tileId": {
      "type": "string",
      "pattern": "^-?\\\\d+:-?\\\\d+$"
    },
    "tileX": {
      "type": "integer"
    },
    "tileZ": {
      "type": "integer"
    },
    "tileSizeMeters": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "bounds": {
      "type": "object",
      "required": [
        "minX",
        "minZ",
        "maxX",
        "maxZ"
      ],
      "properties": {
        "minX": {
          "type": "number"
        },
        "minZ": {
          "type": "number"
        },
        "maxX": {
          "type": "number"
        },
        "maxZ": {
          "type": "number"
        }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": [
        "publisher",
        "datasets"
      ],
      "properties": {
        "publisher": {
          "type": "string"
        },
        "datasets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "layer",
              "datasetId",
              "retrievedAt"
            ],
            "properties": {
              "layer": {
                "enum": [
                  "streets",
                  "buildings"
                ]
              },
              "datasetId": {
                "type": "string"
              },
              "retrievedAt": {
                "type": "string",
                "format": "date-time"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "streets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/feature"
      }
    },
    "buildings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/feature"
      }
    }
  },
  "$defs": {
    "point": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "feature": {
      "type": "object",
      "required": [
        "type",
        "id",
        "properties",
        "geometry"
      ],
      "properties": {
        "type": {
          "const": "Feature"
        },
        "id": {
          "type": [
            "string",
            "number",
            "null"
          ]
        },
        "properties": {
          "type": "object"
        },
        "geometry": {
          "type": "object",
          "required": [
            "type",
            "coordinates"
          ],
          "properties": {
            "type": {
              "enum": [
                "LineString",
                "MultiLineString",
                "Polygon",
                "MultiPolygon"
              ]
            },
            "coordinates": {
              "type": "array"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
